# BookVerse AI — environment variables (all optional; sensible defaults apply).
# Copy to .env.local and adjust as needed.

# AI runtime. One of:
#   ollama         -> local Ollama server (default; dev only)
#   groq           -> Groq hosted API      (set GROQ_API_KEY)
#   gemini         -> Google Gemini API    (set GEMINI_API_KEY)
#   openai         -> OpenAI API           (set OPENAI_API_KEY)
#   openai-compat  -> any OpenAI-style API (set LLM_BASE_URL + LLM_MODEL + LLM_API_KEY)
#   mock           -> force the offline preview generator
# If the selected provider has no key / is unreachable, the app falls back to
# the grounded mock automatically.
AI_PROVIDER=ollama

# --- Local Ollama (used when AI_PROVIDER=ollama) ----------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# How long (ms) to wait when checking if Ollama is up before falling back.
AI_PROBE_TIMEOUT_MS=1500

# --- Hosted providers (set the key for whichever you use) -------------------
# Model lists change over time — if generation falls back to the mock preview,
# check the provider's model list and set the *_MODEL override.
#
# Groq   (default model: openai/gpt-oss-120b) — override with GROQ_MODEL
#   list:  curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
#
# Gemini (default model: gemini-2.0-flash) — override with GEMINI_MODEL
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
#
# OpenAI (default model: gpt-4o-mini) — override with OPENAI_MODEL
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
#
# Any other OpenAI-compatible endpoint (AI_PROVIDER=openai-compat):
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

# Public site URL (used for canonical URLs, sitemap, robots, OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error   (default: debug in dev, info in production)
# LOG_LEVEL=debug

# --- Rate limiting (per client IP; protects the paid AI endpoints) ---------
# RATE_LIMIT_GENERATE_PER_MIN=5
# RATE_LIMIT_GENERATE_PER_DAY=60
# RATE_LIMIT_CHAT_PER_MIN=20
# RATE_LIMIT_CHAT_PER_DAY=400
# RATE_LIMIT_DISABLED=1        # local dev / tests only

# --- Analytics (optional; client-side, privacy-friendly) -------------------
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=bookverse.example.com
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# --- Supabase: hosted Postgres cache + Auth + synced shelves (see DEPLOY.md) --
# Set these three to switch the book cache to Postgres and turn on accounts.
# Leave them blank to keep the local SQLite/localStorage behaviour (default).
# Find them in the Supabase dashboard: Project Settings → API.
#
# NEXT_PUBLIC_SUPABASE_URL      -> "Project URL"        (public, browser-safe)
# NEXT_PUBLIC_SUPABASE_ANON_KEY -> "anon / public" key  (public, browser-safe)
# SUPABASE_SERVICE_ROLE_KEY     -> "service_role" key   (SECRET — server only!)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed to delete generated guides (needs auth above).
# No admin exists unless this is set.
# ADMIN_EMAILS=you@example.com

# --- Other optional pieces (see docs/BACKEND_AND_AUTH.md) --------------------
# Separate .NET backend
# NEXT_PUBLIC_API_URL=http://localhost:5080
# Real image generation (ComfyUI / SD)
# IMAGE_API_URL=http://127.0.0.1:8188
